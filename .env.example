# Copy to .env and fill in locally. Never commit .env.
#
# Preferred (fleet / multi-machine): **Doppler** — see repo-root `doppler.yaml` (project
# `ag-dev-ecosystem`) and `AGENTS.md` § Local development. Use `doppler run -- …` so LLM + GitHub keys
# match across machines without copying `.env` files.

# Example: LLM provider (customize per project)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DISTILL_API_KEY=          # optional; when set, wins over OPENAI_/OPENROUTER_ for distill.py
# DISTILL_BASE_URL=         # optional; include scheme, e.g. https://api.openai.com/v1 (default)
# DISTILL_MODEL=            # optional model id for distillation
# DISTILL_MAX_TOKENS=       # optional completion cap for distill.py (default 4096)
# OLLAMA_HOST=http://127.0.0.1:11434

# Example: database (customize per project)
# DATABASE_URL=

# Claude Code — GitHub MCP (Docker: ghcr.io/github/github-mcp-server; see TOOLCHAIN.md, GITHUB_SETUP.md)
# Fine-grained or classic PAT; never commit. Export before `claude` so the MCP container receives it.
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Child-repo GitHub Actions only: PAT with issues:write on the upstream template repo (see MAINTAINING_THE_TEMPLATE.md, template-feedback workflow). Do not use in local dev unless testing gh CLI.
# TEMPLATE_REPO_TOKEN=

# Process miner (optional): JSON object merging extra GitHub login → short bot_name keys into defaults (see tools/process_miner/bot_authorship.py).
# PROCESS_MINER_BOT_ALIASES_JSON={"my-bot-login":"mybot"}

# AC Copilot sidecar (M0 voice coaching): path to a FASTER reference lap archive JSON.
# Fallback for `python -m tools.ai_sidecar --reference-archive` when the flag is omitted.
# AC_COPILOT_REFERENCE_ARCHIVE=
# Optional returning-driver profile consumed by Coach v2 for progression-aware
# cue density. Generate with `python -m tools.ai_sidecar.driver_profile --lap-dir ...`.
# Must point to a journal/driver/profile.json path.
# AC_COPILOT_DRIVER_PROFILE=%USERPROFILE%\Documents\Assetto Corsa\ac-copilot\journal\driver\profile.json
# Optional: baked phrase-bank directory for in-process voice playback. Requires
# AC_COPILOT_REFERENCE_ARCHIVE so cues can be anchored to the faster reference.
# AC_COPILOT_VOICE_BANK=
# Optional phrase-bank runtime routing. Use a named output so voice does not land
# on the haptic USB DAC; DirectSound accepts common Piper 22050 Hz banks.
# Backend is `sounddevice` (the always-installable floor) or `rtmixer` (lower latency,
# opt-in via `pip install -e ".[voice-rtmixer]"`; #383). The engine falls back to
# sounddevice when rtmixer is not importable, so either value is safe.
# AC_COPILOT_VOICE_BACKEND=sounddevice
# AC_COPILOT_VOICE_DEVICE=
# AC_COPILOT_VOICE_HOST_API=
# AC_COPILOT_VOICE_VERBOSITY=low
# Optional: enable the lightweight pyttsx3 fallback when no phrase bank is configured.
# AC_COPILOT_VOICE_TTS=0
# Optional pyttsx3 fallback tuning (only used when AC_COPILOT_VOICE_TTS=1).
# AC_COPILOT_VOICE_RATE=240
# AC_COPILOT_VOICE_VOLUME=1.0

# AC Copilot rig-screen sidecar autostart (issue #86): set only on the rig PC.
# Token must match firmware/screen/secrets/sidecar.h. Never commit or log a real value.
# AC_COPILOT_SIDECAR_TOKEN=
# Optional: bind/port used when the rig-screen token is set.
# AC_COPILOT_SIDECAR_EXTERNAL_BIND=0.0.0.0
# AC_COPILOT_SIDECAR_PORT=8765

# AC Copilot Game Point launcher (issue #363): per-user status/log root and
# optional SimHub discovery override. The launcher never writes SimHub profiles.
# AC_COPILOT_GAME_POINT_DIR=
# AC_COPILOT_SIMHUB_EXE=
# AC_COPILOT_START_SIMHUB=0
# Optional Setup Exchange proxy/install overrides used by tools.ai_sidecar.
# The public se.acstuff.club endpoint requires CSP session signing; point this
# at an authenticated local proxy/test endpoint, not the raw public endpoint.
# AC_COPILOT_SE_ENDPOINT=http://127.0.0.1:8766
# AC_COPILOT_USER_SETUPS_DIR=%USERPROFILE%\Documents\Assetto Corsa\setups

# Track Titan ingest (issue #353): PERSONAL refresh token for the operator's OWN TT account,
# read by tools.tt_ingest.tt_auth to mint short-lived Cognito tokens. Source from Doppler /
# your shell — NEVER commit a real value. Omit to auto-discover from the Track Titan desktop
# app's Local Storage (Windows) when the app has been signed in.
# TT_REFRESH_TOKEN=
# Optional overrides for the PUBLIC Cognito identifiers (defaults are the app's public ids —
# sent in every unauthenticated request, NOT secrets). Only set to target a different pool.
# TT_COGNITO_CLIENT_ID=
# TT_COGNITO_USER_POOL_ID=
# TT_COGNITO_IDENTITY_POOL_ID=
# TT_COGNITO_REGION=
